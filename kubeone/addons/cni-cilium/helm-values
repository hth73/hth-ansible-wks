cluster:
  name: kubernetes

devices:
  - enp0s8

ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv4PodCIDRList:
      - "172.20.0.0/16"
    clusterPoolIPv4MaskSize: 24

kubeProxyReplacement: true

routingMode: native
ipv4NativeRoutingCIDR: "172.20.0.0/16"
autoDirectNodeRoutes: true

encryption:
  enabled: true
  type: wireguard

cni:
  exclusive: false

preflight:
  enabled: false

l2announcements:
  enabled: true

operator:
  enabled: true
  replicas: 1
  podDisruptionBudget:
    enabled: true

serviceAccounts:
  hubblecertgen:
    create: false
  relay:
    create: false
  ui:
    create: false

hubble:
  enabled: false
  relay:
    enabled: false
  tls:
    enabled: false
    auto:
      enabled: false
      method: cronJob
  ui:
    enabled: false
