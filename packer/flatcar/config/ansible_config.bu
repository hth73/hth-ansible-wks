# Flatcar Ansible Butane configuration
# Date: 2026-11-13

variant: flatcar
version: 1.1.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICn/bnaOdeE/cZaqbDXVP9q96Rj5gs878+9806K0UK2L
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJVpcUidKX5g1Ydq4HW3H560hVzVD5pEHbM8zHHwFYlT

    - name: hth
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICn/bnaOdeE/cZaqbDXVP9q96Rj5gs878+9806K0UK2L
      password_hash: $y$j9T$xtFqbXNWo4Q7ye693r6OG0$3hG8X61jMRQICFMnByai1BKfaHv1B/n3MdxNUf72GR/
      home_dir: /home/hth
      no_create_home: false
      groups:
        - wheel
      shell: /bin/bash

storage:
  files:
    # German keyboard
    - path: /etc/vconsole.conf
      mode: 0644
      overwrite: true
      contents:
        inline: KEYMAP=de

    # Systemd without pager
    - path: /etc/profile.d/systemd-pager.sh
      mode: 0644
      overwrite: true
      contents:
        inline: |
          export SYSTEMD_PAGER=cat

    # Flatcar automatic updates / reboot window
    - path: /etc/flatcar/update.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          REBOOT_STRATEGY=reboot
          LOCKSMITHD_REBOOT_WINDOW_START="Sun 03:00"
          LOCKSMITHD_REBOOT_WINDOW_LENGTH=30m

    # CRI endpoint for containerd
    - path: /etc/crictl.yaml
      mode: 0644
      overwrite: true
      contents:
        inline: |
          runtime-endpoint: unix:///run/containerd/containerd.sock
          image-endpoint: unix:///run/containerd/containerd.sock
          timeout: 10
          debug: false

  links:
    # Timezone
    - path: /etc/localtime
      overwrite: true
      target: ../usr/share/zoneinfo/Europe/Berlin

systemd:
  units:
    # Containerd für Kubernetes dauerhaft aktivieren
    - name: containerd.service
      enabled: true

    # Docker nicht verwenden
    - name: docker.service
      mask: true

    # Verhindert eine Aktivierung über den Docker-Socket
    - name: docker.socket
      mask: true
    
    # start the sshd.service to resolve the issue
    - name: sshd.service
      enabled: true

    # Disable the sshd.socket service due to long wait times for SSH connections
    - name: sshd.socket
      mask: true
