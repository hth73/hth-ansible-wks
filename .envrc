# --------------------------------------------------
# hth-ansible-wks: Kubespray environment
# --------------------------------------------------
export KUBESPRAY_VENV="$HOME/.venvs/kubespray"
export KUBESPRAY_DIR="$PWD/kubespray/upstream"

export KUBESPRAY_CONFIG="$KUBESPRAY_DIR/ansible.cfg"
export KUBESPRAY_INVENTORY="$PWD/inventory/kubespray/hosts.ini"

export ANSIBLE_CONFIG="$KUBESPRAY_CONFIG"
PATH_add "$KUBESPRAY_VENV/bin"
