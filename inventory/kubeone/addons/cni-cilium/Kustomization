apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# Do not set a top-level namespace: the namespace transformer would also move
# the chart's cilium-secrets Namespace, Roles and RoleBindings into kube-system,
# granting Cilium access to all kube-system Secrets. The chart already renders
# everything else into the release namespace below.
helmCharts:
  - name: cilium
    repo: https://helm.cilium.io/
    version: 1.20.2
    releaseName: cilium
    namespace: kube-system
    valuesFile: helm-values

patches:
  # A hack, to compensate for the lack of ability to set .Capabilities when using helmCharts API.
  - target:
      group: policy
      version: v1beta1
      kind: PodDisruptionBudget
      name: cilium-operator
      namespace: kube-system
    patch: |-
      - op: replace
        path: /apiVersion
        value: policy/v1

  # Replace the agent and init-container images with KubeOne-managed images.
  # Hubble-specific hostPort and TLS volume patches are intentionally absent.
  - patch: |-
      apiVersion: apps/v1
      kind: DaemonSet
      metadata:
        name: cilium
        namespace: kube-system
      spec:
        template:
          spec:
            containers:
              - name: cilium-agent
                image: '{{ .InternalImages.Get "Cilium" }}'
            initContainers:
              - name: config
                image: '{{ .InternalImages.Get "Cilium" }}'
              - name: mount-cgroup
                image: '{{ .InternalImages.Get "Cilium" }}'
              - name: apply-sysctl-overwrites
                image: '{{ .InternalImages.Get "Cilium" }}'
              - name: mount-bpf-fs
                image: '{{ .InternalImages.Get "Cilium" }}'
              - name: clean-cilium-state
                image: '{{ .InternalImages.Get "Cilium" }}'
              - name: install-cni-binaries
                image: '{{ .InternalImages.Get "Cilium" }}'

  - patch: |-
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: cilium-operator
        namespace: kube-system
      spec:
        template:
          spec:
            containers:
              - name: cilium-operator
                image: '{{ .InternalImages.Get "CiliumOperator" }}'

  - patch: |-
      apiVersion: apps/v1
      kind: DaemonSet
      metadata:
        name: cilium-envoy
        namespace: kube-system
      spec:
        template:
          spec:
            containers:
              - name: cilium-envoy
                image: '{{ .InternalImages.Get "CiliumEnvoy" }}'
